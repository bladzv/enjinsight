# Daily Staking Cadence scan -> Slack.
#
# Install:
#   sudo cp deploy/systemd/*.service deploy/systemd/*.timer /etc/systemd/system/
#   sudo systemctl daemon-reload
#   sudo systemctl enable --now cadence-scan.timer
#
# Edit User=, WorkingDirectory= and the two paths below to match your install.
# Run it once by hand first:  sudo systemctl start cadence-scan.service
# Watch it:                   journalctl -u cadence-scan -f

[Unit]
Description=EnjinSight daily Staking Cadence scan
Documentation=https://github.com/bladzv/enjinsight
After=network-online.target
Wants=network-online.target
OnFailure=cadence-scan-failure.service

[Service]
Type=oneshot
User=enjinsight
Group=enjinsight
WorkingDirectory=/opt/enjinsight

# systemd's EnvironmentFile parser is stricter than dotenv: `#` starts a comment
# only at the beginning of a line, there is no `export` prefix and no shell
# interpolation. .env.example is written to satisfy those rules.
EnvironmentFile=/opt/enjinsight/.env

# Requires python3 with `requests` and `websockets` installed. `rich`, `dotenv`
# and `cryptography` are optional and only affect presentation/encryption.
ExecStart=/usr/bin/python3 scripts/enjinsight_cli.py \
    --non-interactive \
    --tool staking-cadence \
    --mode both \
    --export json

# A full run is ~6 minutes; this is a generous ceiling that still fails rather
# than hanging if Subscan stops responding.
TimeoutStartSec=45min

# Hardening. ReadWritePaths must cover CADENCE_OUT_DIR.
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/opt/enjinsight/scan-output
ProtectKernelTunables=true
ProtectControlGroups=true
RestrictSUIDSGID=true
LockPersonality=true

[Install]
WantedBy=multi-user.target
