# Copy this file to .env and set your API keys.
# SUBSCAN_API_KEY is required for all Subscan API requests.
# Do NOT commit your .env file to version control — it is already in .gitignore.
#
# These variables are NOT prefixed with VITE_ so keys are NEVER baked into the browser bundle.
# - Dev:        read by vite.config.js (Node context) and injected into Vite's dev proxy.
# - Production: set these as Environment Variables in the Vercel dashboard.
#               The serverless proxy at api/[...proxy].js injects them server-side.
SUBSCAN_API_KEY=
ETHERSCAN_API_KEY=
ALCHEMY_ETH_RPC_URL=
OPENSEA_API_KEY=

# Optional: restrict which upstream hostnames the proxy will forward to.
PROXY_ALLOWLIST=enjin.api.subscan.io
