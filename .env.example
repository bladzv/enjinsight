# ═══════════════════════════════════════════════════════════════════════════
#  EnjinSight — environment configuration
# ═══════════════════════════════════════════════════════════════════════════
#
#  Copy this file to .env and fill in the values you need.
#  .env is already in .gitignore — do NOT commit it.
#
#  None of these are prefixed with VITE_, so no key is ever baked into the
#  browser bundle:
#    - Web app, dev:   read by vite.config.js (Node context) and injected into
#                      Vite's dev proxy.
#    - Web app, prod:  set as Environment Variables in the Vercel dashboard;
#                      api/[...proxy].js injects them server-side.
#    - CLI:            scripts/enjinsight_cli.py reads them from the environment
#                      directly and talks to Subscan itself, with no proxy.
#
#  Sections below:
#    1. API keys           — required / optional upstream credentials
#    2. Proxy behaviour    — web app only
#    3. Scheduled scan     — the non-interactive CLI + Slack report
#
# ═══════════════════════════════════════════════════════════════════════════
#  1. API KEYS
# ═══════════════════════════════════════════════════════════════════════════

# REQUIRED for every Subscan-backed tool (Staking Cadence, Reward History) in
# both the web app and the CLI. Without it Subscan answers 403, or 400 with
# code 20009 ("API key invalid") — the cause is in the JSON body, not the
# status, so a missing key looks like a generic HTTP error.
# Free plan note: most list endpoints cap `row` at 25 and allow ~2 requests/sec.
SUBSCAN_API_KEY=

# REQUIRED for the ENJ Infusion Checker's wallet scans and as the Ethereum RPC
# fallback. Other tools work without it.
ETHERSCAN_API_KEY=

# OPTIONAL. The ENJ Infusion Checker's primary source for token image,
# description and traits, and a fallback name source (on-chain typeData is the
# primary name source). Used by both npm run dev (vite.config.js) and
# production (api/[...proxy].js). Without it, names and quantities still
# resolve on-chain, but images and descriptions stay blank.
OPENSEA_API_KEY=

# OPTIONAL. NOTE: a full RPC endpoint URL, NOT a bare API key — the proxy
# authenticates by embedding the key in the URL path and never sends an auth
# header, so a key on its own cannot be used. Must be https.
# Format: https://eth-mainnet.g.alchemy.com/v2/<your-alchemy-key>
# Leave empty to fall back to Etherscan proxy/eth_call for ENJ Infusion.
ALCHEMY_ETH_RPC_URL=

# ═══════════════════════════════════════════════════════════════════════════
#  2. PROXY BEHAVIOUR  (web app only — the CLI ignores all of these)
# ═══════════════════════════════════════════════════════════════════════════

# OPTIONAL. Restrict which upstream hostnames the proxy will forward to.
PROXY_ALLOWLIST=enjin.api.subscan.io

# OPTIONAL. Extra origins allowed to call the proxy cross-origin (comma-
# separated). The deployment's own Vercel URLs (VERCEL_PROJECT_PRODUCTION_URL,
# VERCEL_BRANCH_URL, VERCEL_URL) are added automatically, as are
# http://localhost:5173 and http://127.0.0.1:5173 outside production. Only
# needed when the app is browsed on a host Vercel does not report — typically a
# custom domain. An unlisted origin gets a hard 403 on every route, so a missing
# entry here can take the whole app down for that domain.
ALLOWED_ORIGINS=

# OPTIONAL shared-secret gate — DO NOT SET for the browser app. If set,
# PROXY_SECRET requires every request to carry a matching `x-proxy-secret`
# header, on every route. No client in this repo (src/utils/api.js,
# scripts/enjinsight_cli.py) ever sends that header, so setting this returns 401
# on every request and breaks the app. Leave unset unless you control a caller
# that adds the header itself.
# PROXY_SECRET=

# ═══════════════════════════════════════════════════════════════════════════
#  3. SCHEDULED STAKING CADENCE SCAN
#     scripts/enjinsight_cli.py --non-interactive
# ═══════════════════════════════════════════════════════════════════════════
#
#  Only needed if you run the scan on a schedule (see deploy/systemd/).
#  The web app and the interactive CLI menu ignore every key in this section.
#
#  NOTE: the Staking Cadence scan needs NO era reference CSV and no archive
#  node. It derives era block ranges from Subscan era_stat alone, cross-checking
#  several validators for consensus. So a scheduled scan cannot be broken by a
#  stale checkout, and the server never needs a `git pull` to stay correct.
#  (public/relay-era-reference.csv is used only by Era Explorer, Balance Viewer
#  and Reward History.)

# How many recent eras each scan covers. 1 era = 1 day on Enjin.
# The web app caps its own scans at 7 eras; the CLI allows up to 100, but each
# extra era costs a full pass over every pool, and above 7 the web app can no
# longer reproduce the same scan for a side-by-side cross-check.
# Default: 1
CADENCE_ERA_COUNT=1

# Which scans to run, comma-separated, in order. Each posts its own Slack
# message, sent as soon as that scan finishes — so a failure in the second
# does not cost you the first.
# Options: validator, pool        Default: validator,pool
CADENCE_MODES=validator,pool

# Directory for the JSON scan exports. Created if missing. These are the files
# you drag into the web app's Staking Cadence -> Import tab.
# Default: ./scan-output
CADENCE_OUT_DIR=./scan-output

# Delete exports in CADENCE_OUT_DIR older than this many days, after each run.
# 0 = keep everything forever.
# Default: 30
CADENCE_KEEP_DAYS=30

# ── Slack delivery ─────────────────────────────────────────────────────────
#
# Setup (a free Slack plan is sufficient):
#   1. https://api.slack.com/apps -> Create New App -> From scratch
#   2. OAuth & Permissions -> Bot Token Scopes -> add `chat:write` and
#      `files:write`
#   3. Install to Workspace, then copy the token that starts with xoxb-
#   4. In Slack, invite the bot to the channel:  /invite @YourApp
#   5. Channel -> View channel details -> copy the ID at the bottom
#
# Free-plan limits: 10 apps per workspace, and messages and files older than
# 90 days are hidden — CADENCE_OUT_DIR is your durable archive.

# Bot token (starts with xoxb-). Required for any Slack delivery.
SLACK_BOT_TOKEN=

# Target channel ID — NOT the #name. Looks like C01ABC2DEFG.
SLACK_CHANNEL_ID=

# true  = attach the full JSON scan export to each Slack message.
# false = post the summary text only. The export is STILL written to
#         CADENCE_OUT_DIR either way, so you can import it manually later.
# Default: true
SLACK_ATTACH_EXPORT=true

# Post a short message when a scan fails outright. Turn this off if the systemd
# OnFailure unit already alerts you and you do not want two pings.
# Default: true
SLACK_NOTIFY_ON_FAILURE=true
