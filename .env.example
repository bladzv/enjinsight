# Copy this file to .env and set your API keys.
# SUBSCAN_API_KEY is required for all Subscan API requests.
# Do NOT commit your .env file to version control — it is already in .gitignore.
#
# These variables are NOT prefixed with VITE_ so keys are NEVER baked into the browser bundle.
# - Dev:        read by vite.config.js (Node context) and injected into Vite's dev proxy.
# - Production: set these as Environment Variables in the Vercel dashboard.
#               The serverless proxy at api/[...proxy].js injects them server-side.
SUBSCAN_API_KEY=
ETHERSCAN_API_KEY=
OPENSEA_API_KEY=

# Optional. NOTE: this is a full RPC endpoint URL, NOT a bare API key — the proxy
# authenticates by embedding the key in the URL path and never sends an auth
# header, so a key on its own cannot be used. Must be https.
# Format: https://eth-mainnet.g.alchemy.com/v2/<your-alchemy-key>
# Leave empty to fall back to Etherscan proxy/eth_call for ENJ Infusion.
ALCHEMY_ETH_RPC_URL=

# Optional: restrict which upstream hostnames the proxy will forward to.
PROXY_ALLOWLIST=enjin.api.subscan.io

# Optional: extra origins allowed to call this proxy cross-origin (comma-separated).
# The deployment's own Vercel URLs (VERCEL_PROJECT_PRODUCTION_URL, VERCEL_BRANCH_URL,
# VERCEL_URL) are added automatically, as are http://localhost:5173 and
# http://127.0.0.1:5173 outside production. Only needed when the app is browsed on a
# host Vercel does not report — typically a custom domain. An unlisted origin gets a
# hard 403 on every route, so a missing entry here can take the whole app down for
# that domain.
ALLOWED_ORIGINS=

# Optional shared-secret gate — DO NOT SET for the browser app. If set, PROXY_SECRET
# requires every request to carry a matching `x-proxy-secret` header, on every route
# (not just Subscan). No client in this repo (src/utils/api.js, scripts/*.py) ever
# sends that header, so setting this returns 401 on every request and breaks the app.
# Leave unset unless you control a caller that adds the header itself.
# PROXY_SECRET=
